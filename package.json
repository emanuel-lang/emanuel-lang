  },
  "dependencies": {
    "leaflet": "1.9.4",
    "lucide": "0.468.0",
    "vite": "6.4.5"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
